--- !u!114 &1688322296
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1688322291}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f49f97108e8820d40ad13c9a34cb4bb1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _isActivated: 0
  _subtitlesList:
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0428\u0435\u043B\u043B\u0438!
      \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0414\u0436\u0435\u043A.
      \u041A\u0430\u043A \u0442\u044B \u0441\u0435\u0431\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C?"
  - Name: "\u0428\u0435\u043B\u043B\u0438"
    Text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0434\u044F\u0434\u044F \u0414\u0436\u0435\u043A.  \u042F \u043E\u0447\u0435\u043D\u044C
      \u0443\u0441\u0442\u0430\u043B\u0430 \u0438 \u0445\u043E\u0447\u0443 \u0441\u043F\u0430\u0442\u044C\u2026\u041D\u043E\u2026 "
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u041D\u0435 \u0431\u043E\u0439\u0441\u044F. \u041C\u044B \u0441 \u0442\u0432\u043E\u0435\u0439
      \u043C\u0430\u043C\u043E\u0439 \u0440\u044F\u0434\u043E\u043C. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438
      \u043C\u043D\u0435 \u043E \u0441\u0432\u043E\u0438\u0445 \u0441\u0442\u0440\u0430\u0445\u0430\u0445,
      \u0447\u0442\u043E \u0442\u0435\u0431\u044F \u043F\u0443\u0433\u0430\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0448\u044C?"
  - Name: "\u0428\u0435\u043B\u043B\u0438"
    Text: "\u0427\u0443\u0434\u043E\u0432\u0438\u0449\u0430! \u041E\u043D\u0438 \u0432\u0441\u044E\u0434\u0443.
      \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
      \u043E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442 \u043C\u0435\u043D\u044F
      \u0441\u044A\u0435\u0441\u0442\u044C."
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043E\u0442 \u0442\u0432\u043E\u0438\u0445 \u0441\u0442\u0440\u0430\u0445\u043E\u0432.
      \u0417\u0430\u043A\u0440\u043E\u0439 \u0433\u043B\u0430\u0437\u0430 \u0438
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0447\u0442\u043E
      \u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F \u0432
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435,
      \u0433\u0434\u0435 \u043D\u0435\u0442 \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u2026 "
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C,
      \u0447\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0442\u0432\u043E\u0438 \u043B\u044E\u0431\u0438\u043C\u044B\u0435 \u0438\u0433\u0440\u0443\u0448\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u0449\u0438\u0442\u044F\u0442
      \u0442\u0435\u0431\u044F \u043E\u0442 \u0447\u0443\u0434\u0438\u0449. \u041A\u0442\u043E
      \u0442\u0432\u043E\u0439 \u0441\u0430\u043C\u044B\u0439 \u0433\u043B\u0430\u0432\u043D\u044B\u0439
      \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A?"
  - Name: "\u0428\u0435\u043B\u043B\u0438"
    Text: "\u042D\u0442\u043E \u0422\u0435\u0434\u0434\u0438! \u041E\u043D \u043C\u043E\u0439
      \u0441\u0430\u043C\u044B\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u043F\u043B\u044E\u0448\u0435\u0432\u044B\u0439
      \u043C\u0438\u0448\u043A\u0430!"
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C,
      \u0447\u0442\u043E \u0422\u0435\u0434\u0434\u0438 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u0442\u0435\u0431\u044F. \u041E\u043D \u043D\u0438\u043A\u043E\u043C\u0443
      \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u043E\u0431\u0438\u0434\u0435\u0442\u044C
      \u0441\u0432\u043E\u044E \u0445\u043E\u0437\u044F\u0439\u043A\u0443. \u0410
      \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u0430\u0441\u044B\u043F\u0430\u0439\u2026"
  _onEndSubtitles:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 777696729}
        m_TargetAssemblyTypeName: Sleep, Assembly-CSharp
        m_MethodName: StartSleep
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
