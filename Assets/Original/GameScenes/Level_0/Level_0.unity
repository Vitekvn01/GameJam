--- !u!114 &129679762
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 129679760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f49f97108e8820d40ad13c9a34cb4bb1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _isActivated: 1
  _subtitlesList:
  - Name: "\u0421\u0438\u043B\u044C\u0432\u0438\u044F \u0413\u043E\u0432\u0430\u0440\u0434"
    Text: "\u0414\u0436\u0435\u043A! \u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430,
      \u0447\u0442\u043E \u0412\u044B \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438!"
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u041C\u0438\u0441\u0441 \u0413\u043E\u0432\u0430\u0440\u0434, \u043D\u0435
      \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0412\u044B \u043F\u043E\u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043E \u0441\u043D\u0430\u0445
      \u0428\u0435\u043B\u043B\u0438?"
  - Name: "\u0421\u0438\u043B\u044C\u0432\u0438\u044F \u0413\u043E\u0432\u0430\u0440\u0434"
    Text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437
      \u0435\u0439 \u0441\u043D\u0438\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
      \u043E\u043D\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430\u0441\u044C
      \u0432 \u0442\u0435\u043C\u043D\u043E\u043C \u043B\u0435\u0441\u0443, \u0433\u0434\u0435
      \u0432\u0441\u044E\u0434\u0443 \u0431\u044B\u043B\u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0435
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0438\u2026 "
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435."
  - Name: "\u0421\u0438\u043B\u044C\u0432\u0438\u044F \u0413\u043E\u0432\u0430\u0440\u0434"
    Text: "\u0418 \u0435\u0449\u0435 \u043E\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0447\u0435\u0439-\u0442\u043E
      \u0441\u043C\u0435\u0445, \u0438 \u044D\u0442\u043E\u0442 \u0441\u043C\u0435\u0445
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0435 \u0432\u043F\u0430\u0441\u0442\u044C
      \u0432 \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u0443\u0436\u0430\u0441.
      \u0411\u0435\u0434\u043D\u044F\u0436\u043A\u0430 \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C. \u041C\u043E\u044F \u043C\u0430\u043B\u044B\u0448\u043A\u0430\u2026"
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u041A\u0430\u043A \u0428\u0435\u043B\u043B\u0438 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441\u0435\u0431\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442?"
  - Name: "\u0421\u0438\u043B\u044C\u0432\u0438\u044F \u0413\u043E\u0432\u0430\u0440\u0434"
    Text: "\u041E\u043D\u0430 \u0431\u043E\u0438\u0442\u0441\u044F \u0437\u0430\u0441\u044B\u043F\u0430\u0442\u044C,
      \u0431\u043E\u0438\u0442\u0441\u044F \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E\u0434\u043D\u0430\u2026 \u042F \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E,
      \u0447\u0442\u043E \u044D\u0442\u0438 \u0441\u043D\u044B \u0442\u0440\u0430\u0432\u043C\u0438\u0440\u0443\u044E\u0442
      \u0435\u0435 \u043F\u0441\u0438\u0445\u0438\u043A\u0443! \u042F\u2026\u044F
      \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C!"
  - Name: "\u0414\u0436\u0435\u043A"
    Text: "\u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0441 \u044D\u0442\u0438\u043C."
  _onEndSubtitles:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1688322296}
        m_TargetAssemblyTypeName: SubtitlesContainer, Assembly-CSharp
        m_MethodName: ActivatedSubtitlesContainer
        m_Mode: 1
