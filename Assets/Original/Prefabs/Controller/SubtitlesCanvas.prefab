  _panelSubtitles: {fileID: 7848244490389511}
  _currentSubtitlesContainer:
  - Name: "\u0420\u0430\u0437\u0440\u0430\u0431 \u0433\u0438\u0442\u0430"
    Text: "\u042F \u043F\u043E\u043B\u043D\u044B\u0439 \u043F\u043E\u043B\u043D\u044B\u0439
      \u0433\u043E\u043C\u043E\u0441\u0435\u043A\u0441\u0443\u0430\u043B\u0438\u0441\u0442
      \u0438 \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0438\u043B
      \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0443 \u0444\u0430\u0439\u043B\u043E\u0432
      \u0431\u043E\u043B\u044C\u0448\u0435 100 \u043C\u0431"
  - Name: "\u042E\u043D\u0438\u0442\u0438 \u0440\u0430\u0437\u0440\u0430\u0431"
    Text: "\u041C\u044B \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438"
  - Name: "\u0420\u0430\u0437\u0440\u0430\u0431 \u0433\u0438\u0442\u0430"
    Text: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435 \u043C\u0435\u043D\u044F,
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0438\u0434\u0442\u0438
      \u0432 \u0431\u0430\u0440 \"\u0433\u043E\u043B\u0443\u0431\u0430\u044F \u0443\u0441\u0442\u0440\u0438\u0446\u0430\""
